{
  "name": "arc-web-monorepo",
  "private": true,
  "packageManager": "pnpm@9.3.0",
  "scripts": {
    "prepare": "husky install",
    "dev": "turbo dev",
    "dev:seller": "pnpm --filter @arc/seller dev",
    "dev:admin": "pnpm --filter @arc/admin dev",
    "dev:storefront": "pnpm --filter @arc/storefront dev",
    "build": "turbo build --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "build:storefront": "pnpm --filter @arc/storefront build",
    "build:seller": "pnpm --filter @arc/seller build",
    "build:admin": "pnpm --filter @arc/admin build",
    "generate": "turbo generate --filter=@arc/storefront",
    "generate:storefront": "pnpm --filter @arc/storefront generate",
    "generate:api-types": "node ./scripts/generate-api-types.mjs",
    "preview": "turbo preview --parallel --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "preview:storefront": "pnpm --filter @arc/storefront preview",
    "preview:seller": "pnpm --filter @arc/seller preview",
    "preview:admin": "pnpm --filter @arc/admin preview",
    "start": "turbo start --parallel --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "start:storefront": "pnpm --filter @arc/storefront start",
    "start:seller": "pnpm --filter @arc/seller start",
    "start:admin": "pnpm --filter @arc/admin start",
    "typecheck": "pnpm typecheck:packages && turbo typecheck --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "typecheck:packages": "pnpm -r --filter \"./packages/*\" typecheck",
    "typecheck:storefront": "pnpm --filter @arc/storefront typecheck",
    "typecheck:seller": "pnpm --filter @arc/seller typecheck",
    "typecheck:admin": "pnpm --filter @arc/admin typecheck",
    "test": "pnpm test:packages && turbo test --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "test:packages": "vitest run --config ./vitest.config.ts",
    "test:packages:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:coverage": "pnpm test:packages:coverage && turbo test:coverage --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "test:storefront": "pnpm --filter @arc/storefront test",
    "test:seller": "pnpm --filter @arc/seller test",
    "test:admin": "pnpm --filter @arc/admin test",
    "check:architecture": "node ./scripts/check-architecture.mjs",
    "check:shared-ui": "node ./scripts/check-shared-ui-drift.mjs",
    "check": "pnpm check:architecture && pnpm check:shared-ui && pnpm lint:packages && pnpm typecheck:packages && pnpm test:packages && turbo check --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "check:storefront": "pnpm --filter @arc/storefront check",
    "check:seller": "pnpm --filter @arc/seller check",
    "check:admin": "pnpm --filter @arc/admin check",
    "lint": "pnpm lint:packages && turbo lint --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "lint:fix": "pnpm lint:packages:fix && turbo lint:fix --filter=@arc/seller --filter=@arc/admin --filter=@arc/storefront",
    "lint:storefront": "pnpm --filter @arc/storefront lint",
    "lint:seller": "pnpm --filter @arc/seller lint",
    "lint:admin": "pnpm --filter @arc/admin lint",
    "lint:fix:storefront": "pnpm --filter @arc/storefront lint:fix",
    "lint:fix:seller": "pnpm --filter @arc/seller lint:fix",
    "lint:fix:admin": "pnpm --filter @arc/admin lint:fix",
    "lint:packages": "eslint --cache --no-warn-ignored \"packages/**/*.{js,ts,vue}\"",
    "lint:packages:fix": "eslint --cache --fix --no-warn-ignored \"packages/**/*.{js,ts,vue}\""
  },
  "author": {
    "name": "Hau Tran",
    "email": "contact@hau.sarl",
    "url": "https://github.com/dauphaihau"
  },
  "devDependencies": {
    "@arc/eslint-config": "workspace:*",
    "@dauphaihau-arc/api-spec": "5.0.0",
    "@dauphaihau/eslint-config": "^0.3.9",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^2.2.1",
    "@nuxt/test-utils": "4.3.4",
    "@nuxtjs/color-mode": "^3.5.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/devtools-api": "^8.2.1",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-vue": "^10.10.0",
    "h3": "1.15.11",
    "happy-dom": "^21.0.4",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "nuxt-security": "2.7.0",
    "openapi-typescript": "6.7.6",
    "tailwindcss": "3.4.19",
    "turbo": "^2.9.18",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/eslint-plugin": "8.66.0",
      "@typescript-eslint/parser": "8.66.0",
      "@typescript-eslint/scope-manager": "8.66.0",
      "@typescript-eslint/type-utils": "8.66.0",
      "@typescript-eslint/types": "8.66.0",
      "@typescript-eslint/typescript-estree": "8.66.0",
      "@typescript-eslint/utils": "8.66.0",
      "@typescript-eslint/visitor-keys": "8.66.0",
      "typescript-eslint": "8.66.0",
      "@tanstack/vue-query": "5.107.1",
      "openapi-typescript>undici": "^6.29.1",
      "@tailwindcss/typography>postcss-selector-parser": "^6.1.5"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@nuxt/ui>zod": "4"
      }
    }
  },
  "volta": {
    "node": "24.19.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
