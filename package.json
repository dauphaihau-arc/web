{
  "name": "arc-web-monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "prepare": "husky install",
    "dev": "turbo dev --parallel",
    "dev:seller": "pnpm --filter @arc/seller dev",
    "dev:storefront": "pnpm --filter @arc/storefront dev",
    "build": "turbo build --filter=@arc/seller --filter=@arc/storefront",
    "build:storefront": "pnpm --filter @arc/storefront build",
    "build:seller": "pnpm --filter @arc/seller build",
    "generate": "turbo generate --filter=@arc/seller --filter=@arc/storefront",
    "generate:storefront": "pnpm --filter @arc/storefront generate",
    "generate:seller": "pnpm --filter @arc/seller generate",
    "preview": "turbo preview --parallel --filter=@arc/seller --filter=@arc/storefront",
    "preview:storefront": "pnpm --filter @arc/storefront preview",
    "preview:seller": "pnpm --filter @arc/seller preview",
    "start": "turbo start --parallel --filter=@arc/seller --filter=@arc/storefront",
    "start:storefront": "pnpm --filter @arc/storefront start",
    "start:seller": "pnpm --filter @arc/seller start",
    "typecheck": "turbo typecheck --filter=@arc/seller --filter=@arc/storefront",
    "typecheck:storefront": "pnpm --filter @arc/storefront typecheck",
    "typecheck:seller": "pnpm --filter @arc/seller typecheck",
    "test": "turbo test --filter=@arc/seller --filter=@arc/storefront",
    "test:storefront": "pnpm --filter @arc/storefront test",
    "test:seller": "pnpm --filter @arc/seller test",
    "check": "pnpm lint:packages && turbo check --filter=@arc/seller --filter=@arc/storefront",
    "check:storefront": "pnpm --filter @arc/storefront check",
    "check:seller": "pnpm --filter @arc/seller check",
    "lint": "pnpm lint:packages && turbo lint --filter=@arc/seller --filter=@arc/storefront",
    "lint:fix": "pnpm lint:packages:fix && turbo lint:fix --filter=@arc/seller --filter=@arc/storefront",
    "lint:storefront": "pnpm --filter @arc/storefront lint",
    "lint:seller": "pnpm --filter @arc/seller lint",
    "lint:fix:storefront": "pnpm --filter @arc/storefront lint:fix",
    "lint:fix:seller": "pnpm --filter @arc/seller lint:fix",
    "lint:packages": "eslint --cache --no-warn-ignored \"packages/**/*.{js,ts,vue}\"",
    "lint:packages:fix": "eslint --cache --fix --no-warn-ignored \"packages/**/*.{js,ts,vue}\""
  },
  "author": {
    "name": "Hau Tran",
    "email": "contact@hautran.me",
    "url": "https://github.com/dauphaihau"
  },
  "devDependencies": {
    "@arc/eslint-config": "workspace:*",
    "@dauphaihau/eslint-config": "^0.3.9",
    "@nuxt/devtools": "^1.3.14",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/image": "^1.6.0",
    "@nuxt/test-utils": "3.14.4",
    "@nuxtjs/color-mode": "^3.3.2",
    "@nuxtjs/i18n": "^8.0.0",
    "@samk-dev/nuxt-vcalendar": "^1.0.2",
    "@types/node": "^22.13.13",
    "@vitest/browser": "^3.2.6",
    "@vue/test-utils": "^2.4.3",
    "@vueuse/core": "^10.7.0",
    "@vueuse/nuxt": "^10.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^15.11.7",
    "husky": "^8.0.3",
    "jsdom": "^23.0.1",
    "lint-staged": "^15.2.0",
    "nuxt-security": "2.0.0-rc.7",
    "tailwindcss": "3.4.14",
    "turbo": "^2.9.18",
    "typescript": "^5.5.4",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^4.2.5",
    "vue-tsc": "^2.0.29"
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/eslint-plugin": "8.66.0",
      "@typescript-eslint/parser": "8.66.0",
      "@typescript-eslint/scope-manager": "8.66.0",
      "@typescript-eslint/type-utils": "8.66.0",
      "@typescript-eslint/types": "8.66.0",
      "@typescript-eslint/typescript-estree": "8.66.0",
      "@typescript-eslint/utils": "8.66.0",
      "@typescript-eslint/visitor-keys": "8.66.0",
      "typescript-eslint": "8.66.0"
    }
  },
  "volta": {
    "node": "20.20.2"
  }
}
