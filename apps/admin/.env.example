API_BASE_URL=http://localhost:4000
# Absolute API origin for browser transports that bypass the /api proxy (websocket, server-sent events).
# Defaults to API_BASE_URL when unset.
API_ORIGIN=
API_VERSION=1
SELLER_APP_URL=http://localhost:4002
STOREFRONT_APP_URL=http://localhost:4001
PORT=4003

ASSET_HOST=
NUXT_PUBLIC_LOG_LEVEL=debug

# Open the admin portal at http://127.0.0.1:4003, never http://localhost:4003.
# Browsers scope cookies by host and ignore the port, so every dev server reached
# through `localhost` shares one cookie jar with the seller portal on `localhost:4002`.
# The admin session cookie must stay host-only and isolated, so the admin origin is
# `127.0.0.1` and AUTH_COOKIE_DOMAIN is never set for this app.
