{
  "name": "@arc/admin",
  "private": true,
  "type": "module",
  "description": "Admin portal for arc built with Nuxt 4, TypeScript, Pinia, and Nuxt UI",
  "scripts": {
    "preview": "nuxt preview",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "nuxt typecheck",
    "test": "pnpm test:unit && pnpm test:nuxt",
    "test:unit": "vitest run --config ./vitest.unit.config.ts",
    "test:nuxt": "vitest run --config ./vitest.config.ts",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix ."
  },
  "dependencies": {
    "@arc/composables": "workspace:*",
    "@arc/contracts": "workspace:*",
    "@arc/enums": "workspace:*",
    "@arc/lib": "workspace:*",
    "@arc/models": "workspace:*",
    "@arc/schemas": "workspace:*",
    "@arc/ui": "workspace:*",
    "@arc/utils": "workspace:*",
    "@formkit/auto-animate": "^0.10.2",
    "@nuxt/ui": "^2.22.3",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/typography": "^0.5.10",
    "@tanstack/vue-query": "^5.107.1",
    "dayjs": "^1.11.10",
    "http-status-codes": "^2.3.0",
    "nuxt": "~4.6.4",
    "pinia": "^4.1.0",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.45",
    "zod": "^3.25.76",
    "@arc/nuxt-vue-query": "workspace:*",
    "@vue/devtools-api": "^8.2.1"
  },
  "devDependencies": {
    "@arc/eslint-config": "workspace:*",
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/fluent": "^1.2.56",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/hugeicons": "^1.2.33",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/lets-icons": "^1.2.2",
    "@iconify-json/lucide": "^1.2.124",
    "@iconify-json/majesticons": "^1.2.5",
    "@iconify-json/material-symbols": "^1.2.89",
    "@iconify-json/mynaui": "^1.2.19",
    "@iconify-json/nimbus": "^1.2.1",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/solar": "^1.2.8",
    "@iconify-json/streamline-flex": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify-json/uil": "^1.2.3"
  },
  "packageManager": "pnpm@9.0.0"
}
