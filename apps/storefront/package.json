{
  "name": "@arc/storefront",
  "private": true,
  "type": "module",
  "description": "Web app for arc app build with Nuxt 4, typescripts, pinia, tailwind, nuxt/ui, zod",
  "scripts": {
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "typecheck": "nuxt typecheck",
    "test": "pnpm test:unit && pnpm test:nuxt",
    "test:unit": "vitest run --config ./vitest.unit.config.ts",
    "test:unit:coverage": "vitest run --config ./vitest.unit.config.ts --coverage",
    "test:nuxt": "vitest run --config ./vitest.config.ts",
    "test:nuxt:coverage": "vitest run --config ./vitest.config.ts --coverage",
    "test:coverage": "pnpm test:unit:coverage && pnpm test:nuxt:coverage",
    "e2e:serve": "pnpm generate",
    "e2e:ssr:build": "API_BASE_URL=http://127.0.0.1:4310 API_VERSION=1 NUXT_PUBLIC_CATEGORY_IDENTITY_CONTRACT_VERSION=2 nuxt build",
    "e2e:ssr": "pnpm e2e:ssr:build && E2E_MODE=ssr playwright test --config ./playwright.config.ts",
    "e2e": "playwright test --config ./playwright.config.ts",
    "e2e:smoke": "E2E_SUITE=smoke playwright test --config ./playwright.config.ts",
    "e2e:headed": "playwright test --config ./playwright.config.ts --headed",
    "e2e:ui": "playwright test --config ./playwright.config.ts --ui",
    "e2e:video": "PLAYWRIGHT_VIDEO_MODE=on playwright test --config ./playwright.config.ts",
    "e2e:video:headed": "PLAYWRIGHT_VIDEO_MODE=on playwright test --config ./playwright.config.ts --headed",
    "e2e:video:mp4": "pnpm e2e:video && node ./scripts/convert-playwright-videos-to-mp4.mjs",
    "e2e:video:mp4:headed": "pnpm e2e:video:headed && node ./scripts/convert-playwright-videos-to-mp4.mjs",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "docker:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "docker:prod": "docker-compose -f docker-compose.yml -f docker-compose.prod.yml up"
  },
  "devDependencies": {
    "@arc/eslint-config": "workspace:*",
    "@iconify-json/akar-icons": "^1.2.7",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/fluent": "^1.2.56",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/hugeicons": "^1.2.33",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/lets-icons": "^1.2.2",
    "@iconify-json/lucide": "^1.2.124",
    "@iconify-json/majesticons": "^1.2.5",
    "@iconify-json/material-symbols": "^1.2.89",
    "@iconify-json/mynaui": "^1.2.19",
    "@iconify-json/nimbus": "^1.2.1",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/solar": "^1.2.8",
    "@iconify-json/streamline-flex": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify-json/uil": "^1.2.3",
    "@playwright/test": "latest",
    "serve": "^14.2.7"
  },
  "dependencies": {
    "@arc/composables": "workspace:*",
    "@arc/contracts": "workspace:*",
    "@arc/enums": "workspace:*",
    "@arc/lib": "workspace:*",
    "@arc/models": "workspace:*",
    "@arc/nuxt-vue-query": "workspace:*",
    "@arc/schemas": "workspace:*",
    "@arc/ui": "workspace:*",
    "@arc/utils": "workspace:*",
    "@formkit/auto-animate": "^0.10.2",
    "@nuxt/ui": "^2.22.3",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/typography": "^0.5.10",
    "@tanstack/vue-query": "^5.107.1",
    "@vue/devtools-api": "^8.2.1",
    "dayjs": "^1.11.10",
    "http-status-codes": "^2.3.0",
    "libphonenumber-js": "^1.13.15",
    "nuxt": "~4.6.4",
    "pinia": "^4.1.0",
    "postcode-validator": "^3.10.26",
    "vue": "^3.5.45",
    "zod": "^4.6.6"
  },
  "web-types": "./web-types.json",
  "packageManager": "pnpm@9.0.0"
}
