  "cards": [
    {
      "dot": "emerald",
      "title": "Recoverable Codes Only",
      "items": [
        "Refresh runs only for ACCESS_TOKEN_EXPIRED and ACCESS_TOKEN_MISSING",
        "Any other 401 and every 403 go straight to the guest result"
      ]
    },
    {
      "dot": "cyan",
      "title": "Single Flight in the Browser",
      "items": [
        "Concurrent browser requests await one shared refresh promise",
        "Server clients never share refresh work across users"
      ]
    },
    {
      "dot": "orange",
      "title": "Where the Cookies Live",
      "items": [
        "The API rotates the HttpOnly pair as Set-Cookie",
        "Storefront calls the API origin directly with credentials: include"
      ]
    }
