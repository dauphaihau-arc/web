        "focus": [
          "caller",
          "entry",
          "api"
        ],
        "note": "Only ACCESS_TOKEN_EXPIRED and ACCESS_TOKEN_MISSING reach the refresh call; every other 401 or 403 ends as a guest."
      },
      {
        "id": "rotate",
        "label": "Rotate the session",
        "focus": [
          "caller",
          "entry",
          "api"
        ],
        "note": "Concurrent browser requests share one refresh promise instead of firing one rotation each."
      },
      {
        "id": "replay",
        "label": "Replay once",
        "focus": [
          "caller",
          "entry",
          "api"
        ],
        "note": "The original request is retried a single time with the rotated cookies; a rejected refresh rethrows the first error."
      }
    ]
  },
