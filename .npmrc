shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

# OpenAPI contract package is published to GitHub Packages by the api repo.
# Installing it requires a token in NODE_AUTH_TOKEN with read:packages access
# for the dauphaihau-arc org. Never commit the token itself.
@dauphaihau-arc:registry=https://npm.pkg.github.com
# Provide the token via the environment (or your user-level ~/.npmrc):
# //npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
